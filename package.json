    "expo-status-bar": "~57.0.1",
    "formik": "^2.4.9",
    "graphql": "^16.14.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "^0.21.0",
